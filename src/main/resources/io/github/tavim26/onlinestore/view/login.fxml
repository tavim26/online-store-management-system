<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="io.github.tavim26.onlinestore.ui.controller.LoginController"
           styleClass="page">

    <VBox styleClass="card" spacing="10" maxWidth="380" maxHeight="-Infinity">
        <Label text="Online Store" styleClass="title"/>
        <Label text="Sign in to your account" styleClass="subtitle"/>

        <Label text="Email"/>
        <TextField fx:id="emailField" promptText="you@example.com"/>

        <Label text="Password"/>
        <PasswordField fx:id="passwordField"/>

        <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>

        <Button fx:id="loginButton" text="Sign in" styleClass="primary"
                defaultButton="true" maxWidth="Infinity" onAction="#onLogin"/>
        <Hyperlink text="No account yet? Create one" onAction="#onGoToRegister"/>
    </VBox>
</StackPane>