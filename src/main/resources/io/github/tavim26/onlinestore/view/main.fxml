<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="io.github.tavim26.onlinestore.ui.controller.MainController"
            styleClass="page">

    <top>
        <HBox styleClass="top-bar" spacing="6" alignment="CENTER_LEFT">
            <Label text="Online Store" styleClass="brand"/>
            <Region prefWidth="12"/>
            <Button text="Products" styleClass="nav-button" onAction="#onProducts"/>
            <Button fx:id="cartButton" text="Cart" styleClass="nav-button" onAction="#onCart"/>
            <Button text="Orders" styleClass="nav-button" onAction="#onOrders"/>
            <Button text="Wishlist" styleClass="nav-button" onAction="#onWishlist"/>
            <Button text="Account" styleClass="nav-button" onAction="#onAccount"/>
            <MenuButton fx:id="adminMenu" text="Admin" styleClass="nav-button">
                <items>
                    <MenuItem text="Manage products" onAction="#onAdminProducts"/>
                    <MenuItem text="All orders" onAction="#onAdminOrders"/>
                </items>
            </MenuButton>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel"/>
            <Label fx:id="balanceLabel" styleClass="balance"/>
            <Button text="Sign out" onAction="#onLogout"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>