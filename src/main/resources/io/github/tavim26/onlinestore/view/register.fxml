<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="io.github.tavim26.onlinestore.ui.controller.RegisterController"
           styleClass="page">

    <VBox styleClass="card" spacing="12" maxWidth="580" maxHeight="-Infinity">
        <Label text="Create account" styleClass="title"/>
        <Label text="All fields are required." styleClass="subtitle"/>

        <GridPane hgap="14" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="First name"/>
                <TextField fx:id="firstNameField"/>
            </VBox>
            <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label text="Last name"/>
                <TextField fx:id="lastNameField"/>
            </VBox>

            <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="Email"/>
                <TextField fx:id="emailField" promptText="you@example.com"/>
            </VBox>
            <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label text="Phone"/>
                <TextField fx:id="phoneField" promptText="07xxxxxxxx"/>
            </VBox>

            <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="0">
                <Label text="Password"/>
                <PasswordField fx:id="passwordField" promptText="At least 8 characters, letters and digits"/>
            </VBox>
            <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="1">
                <Label text="Confirm password"/>
                <PasswordField fx:id="confirmPasswordField"/>
            </VBox>

            <VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="0">
                <Label text="CNP"/>
                <TextField fx:id="cnpField" promptText="13 digits"/>
            </VBox>

            <VBox spacing="4" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2">
                <Label text="Address"/>
                <TextField fx:id="addressField"/>
            </VBox>
        </GridPane>

        <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>

        <HBox spacing="10">
            <Button fx:id="registerButton" text="Create account" styleClass="primary"
                    defaultButton="true" onAction="#onRegister"/>
            <Button text="Back to sign in" onAction="#onBackToLogin"/>
        </HBox>
    </VBox>
</StackPane>